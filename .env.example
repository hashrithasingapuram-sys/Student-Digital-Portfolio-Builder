# PortfolioX backend configuration (safe to commit: placeholders only)
# Copy this file to ".env" and replace the placeholder values with your own.
PORT=3000
NODE_ENV=development

# Supabase Dashboard -> Project Settings -> API -> "Project URL"
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_)
# (older projects: the "anon public" key). This key is designed to be public.
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
